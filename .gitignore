# Secrets and private config (never commit these)
.env
.env.*
*.pem
*.key

# Like counter data (the real database lives in a Docker volume on the M710q)
*.db
*.sqlite
*.sqlite3
like-api/data/

# Python leftovers
__pycache__/
*.pyc

# Computer and editor junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
